# Access to the serial node pyserial opens (/dev/ttyACM* or /dev/ttyUSB*).
#
# Betaflight Configurator README tells a Linux user to join the dialout group
# and log in again. That does not change a port that is already open in this
# session. INAV Configurator assets/linux/45-inav.rules sets MODE="0666" for
# the USB ids below, except the DFU bootloader ids, which are only for
# flashing and are not copied. ArduPilot libraries/AP_HAL_ChibiOS/hwdef/scripts/chibios_hwdef.py
# defaults to 1209:5740 and 1209:5741.
#
# The match is SUBSYSTEM=="tty" because that is the node /dev/ttyACM0.
# A rule on SUBSYSTEM=="usb" changes /dev/bus/usb and leaves the tty node closed.

# STM32 VCP, the Betaflight and INAV flight-controller port. INAV 45-inav.rules.
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", MODE="0666"

# AT32 VCP. INAV 45-inav.rules.
SUBSYSTEM=="tty", ATTRS{idVendor}=="2e3c", ATTRS{idProduct}=="5740", MODE="0666"

# APM32 VCP. INAV 45-inav.rules.
SUBSYSTEM=="tty", ATTRS{idVendor}=="314b", ATTRS{idProduct}=="5740", MODE="0666"

# ST-Link VCP on NUCLEO boards. INAV 45-inav.rules.
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="374e", MODE="0666"

# ArduPilot default USB ids. chibios_hwdef.py get_USB_IDs.
SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="5740", MODE="0666"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="5741", MODE="0666"

# FTDI and CP210x serial adapters. INAV 45-inav.rules.
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", MODE="0666"
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE="0666"
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea61", MODE="0666"
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea62", MODE="0666"
